    {
      "type": "bargauge",
      "title": "CPU used",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * avg(1 - rate(node_cpu_seconds_total{job=\"node_exporter\", mode=\"idle\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "homeserver"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * avg by (node) (1 - rate(node_cpu_seconds_total{job=\"k3s_node_exporter\", node=~\".+\", mode=\"idle\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
