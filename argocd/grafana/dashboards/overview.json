    {
      "type": "stat",
      "title": "Infrastructure",
      "description": "Homeserver and nodes up, host containers seen, every scrape target up, no offline runner.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"node_exporter\"}",
          "refId": "A",
          "legendFormat": "homeserver"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_node_status_condition{condition=\"Ready\", status=\"true\"}",
          "refId": "B",
          "legendFormat": "{{node}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(time() - max by (name) (container_last_seen{job=\"cadvisor\", name!=\"\", name!~\"nextcloud-aio-(borgbackup|watchtower)\"}) < bool 120)",
          "refId": "C",
          "legendFormat": "host containers"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(up)",
          "refId": "D",
          "legendFormat": "monitoring targets"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(github_runners{state=\"offline\"}) == bool 0",
          "refId": "E",
          "legendFormat": "CI runners"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
