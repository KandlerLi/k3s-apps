        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "stat",
      "title": "CPU (Kerne)",
      "description": "Genutzte und freie CPU-Kerne des Homeservers, inklusive allem, was auf ihm läuft (k3s-VMs, Docker, Dienste).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 7,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(1 - rate(node_cpu_seconds_total{job=\"node_exporter\", mode=\"idle\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "genutzt"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(node_cpu_seconds_total{job=\"node_exporter\", mode=\"idle\"}[$__rate_interval]))",
          "refId": "B",
