{
  "uid": "monitoring-node-resources",
  "title": "Host & k3s Node Resources",
  "tags": [
    "monitoring"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "description": "CPU und RAM des Homeservers und je k3s-Node, Verbrauch nach Namespace/App mit Drill-down auf die Pods.",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "query": {
          "query": "label_values(node_memory_MemTotal_bytes{job=\"k3s_node_exporter\"}, node)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(node_memory_MemTotal_bytes{job=\"k3s_node_exporter\"}, node)",
        "regex": "",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "query": {
          "query": "label_values(container_memory_working_set_bytes{job=\"k3s_kubelet_cadvisor\", container!=\"\", node=~\"$node\"}, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(container_memory_working_set_bytes{job=\"k3s_kubelet_cadvisor\", container!=\"\", node=~\"$node\"}, namespace)",
        "regex": "",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "workload",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "query": {
          "query": "query_result(sum by (namespace, workload) (label_replace(label_replace(container_memory_working_set_bytes{job=\"k3s_kubelet_cadvisor\", container!=\"\", pod!=\"\", node=~\"$node\", namespace=~\"$namespace\"}, \"workload\", \"$1\", \"pod\", \"(.+)\"), \"workload\", \"$1\", \"pod\", \"^(.+?)(-[a-z0-9]{8,10})?-[a-z0-9]{5}$\")))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "query_result(sum by (namespace, workload) (label_replace(label_replace(container_memory_working_set_bytes{job=\"k3s_kubelet_cadvisor\", container!=\"\", pod!=\"\", node=~\"$node\", namespace=~\"$namespace\"}, \"workload\", \"$1\", \"pod\", \"(.+)\"), \"workload\", \"$1\", \"pod\", \"^(.+?)(-[a-z0-9]{8,10})?-[a-z0-9]{5}$\")))",
        "regex": "/workload=\"([^\"]+)\"/",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "allValue": ".*"
      }
    ]
  },
