      "title": "Jobs failed (24 h)",
      "description": "Jobs created in the last 24 hours with at least one failed Pod.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((kube_job_status_failed{namespace=~\"$namespace\"} > 0) and on (namespace, job_name) (time() - kube_job_created{namespace=~\"$namespace\"} < 86400)) or vector(0)",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
