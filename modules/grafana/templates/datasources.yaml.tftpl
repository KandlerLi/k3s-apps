apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://192.168.101.1:9090
    isDefault: true
    editable: false
  - name: blocky-postgresql
    uid: blocky-postgres
    type: postgres
    access: proxy
    url: blocky-svc:5432
    user: blocky
    # database belongs in jsonData, not as a top-level field -- same
    # fix home-infra's own grafana_datasources.yml.j2 already needed
    # (confirmed live 2026-08-28 against Grafana's current provisioning
    # docs).
    jsonData:
      database: blocky_query_log
      sslmode: disable
      postgresVersion: 1700
    secureJsonData:
      password: ${blocky_postgres_password}
    editable: false
